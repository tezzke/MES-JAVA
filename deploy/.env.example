# 复制为 deploy/.env 后填写；deploy/.env 不应提交到版本库。
# 密码留空会被 docker-compose.yml 拒绝。请用密码管理器生成强随机值。
MYSQL_DATABASE=mes
MYSQL_USER=mes_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 必须是浏览器实际访问的 HTTPS Origin，不含路径和结尾斜杠；多个值以逗号分隔。
MES_ALLOWED_ORIGINS=https://mes.example.invalid

# 仅空库首次创建 admin 时临时填写强随机值。
# admin 创建并在页面轮换密码后清空，再重建 mes 容器。
MES_BOOTSTRAP_ADMIN_PASSWORD=

# 现场单设备 Modbus 只读诊断默认关闭。启用时必须设置最小 CIDR/端口白名单。
MES_MODBUS_PROBE_ENABLED=false
MES_MODBUS_PROBE_ALLOWED_CIDRS=
MES_MODBUS_PROBE_ALLOWED_PORTS=502
MES_MODBUS_PROBE_MAX_CONCURRENT=2
