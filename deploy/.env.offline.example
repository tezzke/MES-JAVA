# 复制到安全位置（安装脚本默认 /opt/mes/config/mes.env），权限必须为 0600。
MYSQL_DATABASE=mes
MYSQL_USER=mes_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_PASSWORD

# 浏览器实际使用的唯一 HTTP Origin；必须精确到协议、主机和可选端口，无路径、无末尾斜杠。
MES_ALLOWED_ORIGIN=http://192.168.10.20

# 只在全新数据库首次启动时设置；登录并修改 admin 密码后清空并执行 upgrade.sh。
MES_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# 扫码枪 TCP 接入口。HTTP 应用端口 5100 不对宿主机发布。
SCANNER_BIND_ADDRESS=0.0.0.0
SCANNER_PORT=6001

# 现场单设备只读诊断。默认关闭；启用时 CIDR 不得为空，并应尽量缩小到设备网段。
MES_MODBUS_PROBE_ENABLED=false
MES_MODBUS_PROBE_ALLOWED_CIDRS=192.168.10.0/24
MES_MODBUS_PROBE_ALLOWED_PORTS=502
MES_MODBUS_PROBE_MAX_CONCURRENT=2
