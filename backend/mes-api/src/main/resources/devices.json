        { "Name": "LensTemp", "DisplayName": "镜片温度", "Unit": "℃", "Address": 4, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 100, "AlarmHigh": 55 },
        { "Name": "MarkSpeed", "DisplayName": "打标速度", "Unit": "mm/s", "Address": 5, "DataType": "UInt16", "RangeMin": 0, "RangeMax": 3000 }
      ],
      "aging": [
        { "Name": "Status", "DisplayName": "运行状态", "Address": 0, "DataType": "UInt16", "IsStatus": true },
        { "Name": "ProductCount", "DisplayName": "累计老化数", "Unit": "件", "Address": 1, "DataType": "UInt32", "IsCounter": true },
