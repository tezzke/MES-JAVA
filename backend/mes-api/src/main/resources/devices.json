      { "DeviceId": "ASM-02", "Name": "装配工作站2号", "Type": "assembly", "Line": "装配检测段", "IpAddress": "192.168.1.18", "UnitId": 1, "Template": "assembly", "Position": { "X": -12, "Z": 2, "RotationY": 180 } },
