      { "DeviceId": "PACK-01", "Name": "自动包装机", "Type": "packer", "Line": "包装码垛段", "IpAddress": "192.168.1.24", "UnitId": 1, "Template": "packer", "Position": { "X": 0, "Z": 12 } },
      { "DeviceId": "ROBOT-01", "Name": "码垛机器人", "Type": "robot", "Line": "包装码垛段", "IpAddress": "192.168.1.25", "UnitId": 1, "Template": "robot", "Position": { "X": 12, "Z": 12 } }
    ]
  },

  // 扫码枪接入:真实模式下扫码枪以 TCP Client 连到本机 6001 端口,按来源 IP 绑定工位
  "Scanner": {
    "Enabled": true,
    "ListenPort": 6001,
    "SimulateIntervalMs": 8000,
    "ScannerBindings": {
      // 模拟模式:key 为虚拟扫码枪编号;真实模式:key 改为扫码枪的 IP 地址
      "SIM-SCANNER-01": "ASM-01",
      "SIM-SCANNER-02": "TEST-01",
      "SIM-SCANNER-03": "PACK-01"
    }
  }
}
