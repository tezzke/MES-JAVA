{
  // ============================================================================
  // 设备点表配置 —— 现场部署唯一需要修改的文件
  //   Mode:        Simulation = 模拟数据(开发测试);Modbus = 真实汇川 PLC 采集
  //   PointTemplates:点位模板库,同型号设备复用同一份寄存器表
  //   Devices:     设备清单(IP / 从站号 / 模板 / 3D 坐标)
  // 寄存器地址为 0 基址;Scale/Offset:工程值 = 原始值 × Scale + Offset
  // 每个模板固定约定:地址 0 = 状态字(0 离线 1 待机 2 运行 3 报警),地址 1~2 = 累计产量(UInt32)
  // 生产部署时把本文件拷到 jar 旁边即可覆盖内置档案,无需重新打包
  // ============================================================================
  "Acquisition": {
    "Mode": "Simulation",
    "DefaultPollIntervalMs": 1000,
    "ReconnectDelayMs": 5000,
    "ReadTimeoutMs": 3000,

    "PointTemplates": {
      "loader": [
        { "Name": "Status", "DisplayName": "运行状态", "Address": 0, "DataType": "UInt16", "IsStatus": true },
        { "Name": "ProductCount", "DisplayName": "累计上料数", "Unit": "件", "Address": 1, "DataType": "UInt32", "IsCounter": true },
        { "Name": "HopperLevel", "DisplayName": "料仓余量", "Unit": "%", "Address": 3, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 100, "AlarmLow": 15 },
        { "Name": "VibrationFreq", "DisplayName": "振动频率", "Unit": "Hz", "Address": 4, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 300 },
        { "Name": "MotorCurrent", "DisplayName": "电机电流", "Unit": "A", "Address": 5, "DataType": "UInt16", "Scale": 0.01, "RangeMin": 0, "RangeMax": 20, "AlarmHigh": 15 }
      ],
      "cnc": [
        { "Name": "Status", "DisplayName": "运行状态", "Address": 0, "DataType": "UInt16", "IsStatus": true },
        { "Name": "ProductCount", "DisplayName": "累计加工数", "Unit": "件", "Address": 1, "DataType": "UInt32", "IsCounter": true },
        { "Name": "SpindleSpeed", "DisplayName": "主轴转速", "Unit": "rpm", "Address": 3, "DataType": "UInt16", "RangeMin": 0, "RangeMax": 12000 },
        { "Name": "SpindleTemp", "DisplayName": "主轴温度", "Unit": "℃", "Address": 4, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 150, "AlarmHigh": 80 },
        { "Name": "SpindleCurrent", "DisplayName": "主轴电流", "Unit": "A", "Address": 5, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 60, "AlarmHigh": 45 },
        { "Name": "FeedRate", "DisplayName": "进给速度", "Unit": "mm/min", "Address": 6, "DataType": "UInt16", "RangeMin": 0, "RangeMax": 5000 }
