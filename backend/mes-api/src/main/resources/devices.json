      { "DeviceId": "TEST-02", "Name": "综合测试台2号", "Type": "tester", "Line": "装配检测段", "IpAddress": "192.168.1.21", "UnitId": 1, "Template": "tester", "Position": { "X": 12, "Z": 2, "RotationY": 180 } },
      { "DeviceId": "LASER-01", "Name": "激光打标机", "Type": "laser", "Line": "装配检测段", "IpAddress": "192.168.1.22", "UnitId": 1, "Template": "laser", "Position": { "X": 20, "Z": 2, "RotationY": 180 } },

