      "washer": [
        { "Name": "Status", "DisplayName": "运行状态", "Address": 0, "DataType": "UInt16", "IsStatus": true },
        { "Name": "ProductCount", "DisplayName": "累计清洗数", "Unit": "件", "Address": 1, "DataType": "UInt32", "IsCounter": true },
