        { "Name": "ProductCount", "DisplayName": "累计码垛数", "Unit": "件", "Address": 1, "DataType": "UInt32", "IsCounter": true },
        { "Name": "JointTemp", "DisplayName": "关节温度", "Unit": "℃", "Address": 3, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 120, "AlarmHigh": 70 },
        { "Name": "MotorCurrent", "DisplayName": "伺服电流", "Unit": "A", "Address": 4, "DataType": "UInt16", "Scale": 0.01, "RangeMin": 0, "RangeMax": 30, "AlarmHigh": 25 },
        { "Name": "CycleTime", "DisplayName": "码垛节拍", "Unit": "s", "Address": 5, "DataType": "UInt16", "Scale": 0.1, "RangeMin": 0, "RangeMax": 60 }
      ]
    },

    "Devices": [
      // -------- 机加工段(第一排,z = -8)--------
      { "DeviceId": "LOADER-01", "Name": "自动上料机", "Type": "loader", "Line": "机加工段", "IpAddress": "192.168.1.11", "UnitId": 1, "Template": "loader", "Position": { "X": -20, "Z": -8 } },
      { "DeviceId": "CNC-01", "Name": "CNC加工中心1号", "Type": "cnc", "Line": "机加工段", "IpAddress": "192.168.1.12", "UnitId": 1, "Template": "cnc", "Position": { "X": -12, "Z": -8 } },
      { "DeviceId": "CNC-02", "Name": "CNC加工中心2号", "Type": "cnc", "Line": "机加工段", "IpAddress": "192.168.1.13", "UnitId": 1, "Template": "cnc", "Position": { "X": -4, "Z": -8 } },
      { "DeviceId": "CNC-03", "Name": "CNC加工中心3号", "Type": "cnc", "Line": "机加工段", "IpAddress": "192.168.1.14", "UnitId": 1, "Template": "cnc", "Position": { "X": 4, "Z": -8 } },
