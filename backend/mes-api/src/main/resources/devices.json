        { "Name": "PumpPressure", "DisplayName": "泵压力", "Unit": "MPa", "Address": 4, "DataType": "UInt16", "Scale": 0.001, "RangeMin": 0, "RangeMax": 1, "AlarmHigh": 0.8, "AlarmLow": 0.1 },
